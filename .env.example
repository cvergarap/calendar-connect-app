# ============================================================
# Calendar Connect App · plantilla de variables de entorno
# Copia este archivo a `.env` y completa los valores.
# NUNCA subas `.env` al repositorio ni compartas sus valores.
# ============================================================

# --- General ---
NODE_ENV=development
APP_PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
TZ=America/Bogota
LOG_LEVEL=info

# --- Seguridad (genera con: openssl rand -base64 32 / openssl rand -hex 32) ---
APP_ENCRYPTION_KEY=
SESSION_SECRET=
MCP_AUTH_TOKEN=

# --- Base de datos ---
POSTGRES_DB=cca
POSTGRES_USER=cca
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://cca:${POSTGRES_PASSWORD}@db:5432/cca

# --- Google (PRE-01 a PRE-04) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Scopes mínimos (verificar nombres en la consola de Google)
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar.readonly https://www.googleapis.com/auth/calendar.app.created
REGISTRO_CALENDAR_NAME=Registro

# --- Telegram (PRE-06, PRE-07) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_MODE=polling

# --- LLM (PRE-08) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_MONTHLY_BUDGET_USD=
LLM_BUDGET_WARN_PCT=80

# --- Transcripción de voz (PRE-09) ---
STT_PROVIDER=
STT_API_KEY=
STT_LANGUAGE=es

# --- ICS opcional (PRE-10) · tratar como contraseñas ---
ICS_OUTLOOK_URL=
ICS_UNIVERSITY_URL=
ICS_REFRESH_MINUTES=15

# --- Privacidad (PRE-15) ---
# Categorías cuyos títulos NO se envían al LLM (separadas por coma)
HIDE_TITLES_CATEGORIES=trabajo

# --- Preferencias por defecto (editables luego con /config) ---
WORK_HOURS=08:00-18:00
WORK_DAYS=1,2,3,4,5
MIN_FOCUS_MINUTES=90
MEETING_BUFFER_MINUTES=10
BRIEF_TIME=07:00

# --- Fase 3 (opcional; dejar vacío hasta activar) ---
CLICKUP_API_TOKEN=
ASANA_TOKEN=
GITHUB_TOKEN=
SLACK_TOKEN=
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=
